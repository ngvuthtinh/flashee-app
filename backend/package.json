{
  "name": "flashee-app",
  "version": "1.0.0",
  "description": "Full-stack E-commerce &amp; Flash Sale platform with real-time stock tracking and high-concurrency checkout engine.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:down": "tsx src/database/migrate.ts down",
    "db:migrate:create": "node-pg-migrate create -m src/database/migrations -j sql",
    "db:seed": "tsx src/database/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvuthtinh/flashee-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ngvuthtinh/flashee-app/issues"
  },
  "homepage": "https://github.com/ngvuthtinh/flashee-app#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
