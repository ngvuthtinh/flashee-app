{
  "compilerOptions": {
    // === File Layout ===
    "rootDir": "./src",
    "outDir": "./dist",

    // === Module System ===
    // commonjs = standard cho Node.js/Express backend
    // nodenext thích hợp cho ESM thuần, dễ conflict với thư viện CJS như express
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "esModuleInterop": true,       // Cho phép import express from 'express' (thay vì import * as)
    "allowSyntheticDefaultImports": true,

    // === Type Checking ===
    "strict": true,                // Bật tất cả strict checks (recommended)
    "skipLibCheck": true,          // Bỏ qua type-check trong node_modules (tăng tốc build)
    "forceConsistentCasingInFileNames": true,

    // === Strict Style (giữ để học tốt) ===
    "noImplicitReturns": true,     // Hàm phải return ở tất cả code paths
    "noUnusedLocals": true,        // Biến local không dùng → lỗi
    "noUnusedParameters": true,    // Param không dùng → lỗi (dùng _ prefix để bypass)

    // === Output ===
    "sourceMap": true              // Giúp debug: map từ JS compiled về TS gốc
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
